DATABASE_URL=postgresql://postgres:password@localhost:5432/growhike
SESSION_SECRET=change-this-to-a-random-string-at-least-32-characters-long
ENABLE_AUTH_BYPASS=true
DEFAULT_AUTH_PROVIDER=demo

# Required for Google login. For local development, use:
# http://localhost:5000/api/auth/google/callback
# For Vercel, use:
# https://your-vercel-domain.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Optional live market data providers. The app still runs without these,
# but live quote/IPO refresh endpoints will have limited coverage.
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
POLYGON_API_KEY=
RAPIDAPI_KEY=
MARKET_DATA_API_KEY=
